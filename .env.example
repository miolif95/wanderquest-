# Copia questo file in .env.local e riempi i valori reali.
# .env.local NON va mai committato (è escluso da .gitignore): contiene segreti.

# --- Supabase ---
# URL del progetto Supabase (Project Settings -> API -> Project URL).
# Esposta al client: è pubblica per design, protetta dalle policy RLS.
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblica "anon" (Project Settings -> API -> anon public).
# Esposta al client: ogni richiesta fatta con questa chiave passa comunque
# attraverso le policy di Row Level Security del database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave "service_role" (Project Settings -> API -> service_role).
# SEGRETA: bypassa completamente le policy RLS. Va usata SOLO nei Route
# Handler server-side (mai nel codice client, mai con prefisso NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# --- Mappa ---
# URL template dei tile CARTO (basemap gratuiti derivati OpenStreetMap,
# nessuna API key richiesta). Placeholder {s}/{z}/{x}/{y} sostituiti da
# Leaflet a runtime.
NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
